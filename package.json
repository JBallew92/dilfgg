{
  "name": "dilf-app-v2",
  "version": "0.1.0",
  "homepage": "https://www.dilf.gg",
  "private": true,
  "dependencies": {
    "bootstrap": "^5.3.3",
    "react": "^19.0.0",
    "react-bootstrap": "^2.10.9",
    "react-dom": "^19.0.0",
    "react-router-bootstrap": "^0.26.3",
    "react-router-dom": "^6.30.0",
    "web-vitals": "^2.1.4"
  },
  "scripts": {
    "photos": "node scripts/optimize-photos.js",
    "prestart": "node scripts/build-photo-index.js && node scripts/write-build-info.js",
    "start": "vite",
    "prebuild": "node scripts/build-photo-index.js && node scripts/write-build-info.js",
    "build": "vite build",
    "postbuild": "node -e \"require('fs').copyFileSync('build/index.html','build/404.html')\"",
    "predeploy": "npm run build",
    "deploy": "gh-pages -d build",
    "pretest": "node scripts/build-photo-index.js && node scripts/write-build-info.js",
    "test": "vitest run",
    "preview": "vite preview"
  },
  "devDependencies": {
    "@testing-library/dom": "^10.4.0",
    "@testing-library/jest-dom": "^6.6.3",
    "@testing-library/react": "^16.2.0",
    "@testing-library/user-event": "^13.5.0",
    "@vitejs/plugin-react": "^4.7.0",
    "gh-pages": "^6.3.0",
    "jsdom": "^26.1.0",
    "sharp": "^0.34.5",
    "vite": "^6.4.5",
    "vitest": "^3.2.7"
  },
  "engines": {
    "node": ">=20"
  }
}
